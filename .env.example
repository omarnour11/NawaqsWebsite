# =====================================================================
# Nawaqss Platform Configuration & Persistent Storage
# =====================================================================

# منفذ السيرفر المحلي
PORT=8080

# المفتاح السري للوحة تحكم الإدارة (Admin Secret Key)
# المفتاح الافتراضي في الكود هو: 0102014+omarO
ADMIN_SECRET_KEY=0102014+omarO

# ---------------------------------------------------------------------
# خيار 1: قاعدة بيانات دائمة (PostgreSQL / Supabase / Neon) [موصى به جداً للـ Vercel]
# ---------------------------------------------------------------------
# يمكنك إنشاء قاعدة بيانات مجانية تماماً في 30 ثانية من https://supabase.com أو https://neon.tech
# والصق رابط الاتصال هنا. الكود سينشئ الجداول تلقائياً ويحفظ المسجلين للأبد!
DATABASE_URL=
# أو يمكنك استخدام أي من المتغيرات التالية (Vercel Postgres متوافقة تلقائياً):
# POSTGRES_URL=

# ---------------------------------------------------------------------
# خيار 2: الربط المباشر مع Google Sheets (موصى به لأصحاب الأعمال)
# ---------------------------------------------------------------------
# رابط Google Apps Script Webhook لنقل كل عميل يسجل فوراً إلى شيت الإكسيل في Google Drive
# انظر ملف google-sheets-script.js لنسخ الكود في دقيقة واحدة
GOOGLE_SHEET_WEBHOOK_URL=

# ---------------------------------------------------------------------
# خيار 3 (إضافي): إشعارات تيليجرام فورية عند تسجيل كل عميل
# ---------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
